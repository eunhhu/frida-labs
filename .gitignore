# dependencies
/node_modules/

# compiled agent bundle (produced by the client at runtime)
/_agent.js
_*.js
*.map

# typescript / build caches
*.tsbuildinfo

# logs
*.log
npm-debug.log*
bun-debug.log*

# editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# GJC runtime/session state stays local; project config and reusable skills ship.
.gjc/*
!.gjc/config.yml
!.gjc/skills/
.gjc/skills/*
!.gjc/skills/*/
!.gjc/skills/*/SKILL.md
artifacts/

# compile
*.bun-build

# compiled launcher binary (regenerate with: bun run build-bin)
/flab
