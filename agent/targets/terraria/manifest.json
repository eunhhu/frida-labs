{
  "compatibility": {
    "osIDs": [
      "macos",
      "windows"
    ],
    "platforms": [
      "darwin",
      "win32"
    ]
  },
  "entrypoint": "main.ts",
  "features": [
    {
      "enabledByDefault": false,
      "id": "god",
      "name": "God Mode (Infinite HP)",
      "optional": false,
      "schema": {
        "default": false,
        "kind": "boolean"
      }
    },
    {
      "enabledByDefault": false,
      "id": "mana",
      "name": "Infinite Mana",
      "optional": false,
      "schema": {
        "default": false,
        "kind": "boolean"
      }
    },
    {
      "enabledByDefault": false,
      "id": "breath",
      "name": "Infinite Breath",
      "optional": false,
      "schema": {
        "default": false,
        "kind": "boolean"
      }
    },
    {
      "enabledByDefault": false,
      "id": "nokb",
      "name": "No Knockback",
      "optional": false,
      "schema": {
        "default": false,
        "kind": "boolean"
      }
    },
    {
      "enabledByDefault": false,
      "id": "fly",
      "name": "Infinite Flight",
      "optional": false,
      "schema": {
        "default": false,
        "kind": "boolean"
      }
    },
    {
      "enabledByDefault": false,
      "id": "env",
      "name": "Environmental Immunity",
      "optional": false,
      "schema": {
        "default": false,
        "kind": "boolean"
      }
    },
    {
      "enabledByDefault": false,
      "id": "maxsummon",
      "name": "Max Summons (99 slots)",
      "optional": false,
      "schema": {
        "default": false,
        "kind": "boolean"
      }
    },
    {
      "enabledByDefault": false,
      "id": "fastuse",
      "name": "Instant Item Use (no cooldown)",
      "optional": false,
      "schema": {
        "default": false,
        "kind": "boolean"
      }
    },
    {
      "enabledByDefault": false,
      "id": "maptp",
      "name": "Map Right-Click Teleport (Mono only)",
      "optional": true,
      "schema": {
        "default": false,
        "kind": "boolean"
      }
    }
  ],
  "icon": {
    "kind": "symbolic",
    "value": "wand-stars"
  },
  "name": "Terraria Instrument",
  "widgets": [
    {
      "id": "stats",
      "kind": {
        "config": {
          "actions": [],
          "columns": [
            {
              "alignment": "leading",
              "id": "k",
              "name": "Stat"
            },
            {
              "alignment": "trailing",
              "id": "v",
              "name": "Value"
            }
          ],
          "maxRows": 1000
        },
        "kind": "table"
      },
      "name": "Live Stats",
      "persistence": "none"
    },
    {
      "id": "console",
      "kind": {
        "config": {
          "maxEntries": 1000,
          "placeholder": "give <type> [stack] [prefix] | clear <slot> | dupe <slot> [count] | tp <x> <y> | summon <n> | heal | time | help",
          "prompt": "›",
          "runButtonLabel": "Run"
        },
        "kind": "console"
      },
      "name": "Instrument Console",
      "persistence": "none"
    }
  ]
}
