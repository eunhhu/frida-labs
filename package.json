{
  "name": "frida-labs",
  "version": "1.0.0",
  "description": "Cross-game Frida debugging workspace: reusable lib + per-target scripts + Bun host client",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun host/client.ts",
    "build": "bun host/client.ts --build",
    "typecheck": "tsc -p tsconfig.json && tsc -p host/tsconfig.json"
  },
  "dependencies": {
    "frida": "^17.16.4"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.0.0",
    "@types/node": "^18.14.0",
    "frida-compile": "^19.0.5",
    "frida-il2cpp-bridge": "^0.13.1",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "frida"
  ]
}
